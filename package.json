{
  "name": "@cagudelo/mcp-db-connect",
  "version": "1.6.3",
  "description": "Servidor MCP para acceso a bases de datos",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:win": "tsc && if exist .env copy .env dist\\.env",
    "build:unix": "tsc && cp .env dist/.env && chmod 775 dist/server-sse.js",
    "start": "node dist/index.js",
    "start:sse": "node dist/server-sse.js",
    "dev": "tsx src/index.ts",
    "dev:sse": "tsx src/server-sse.ts",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "database",
    "sqlite",
    "sqlserver",
    "postgresql",
    "mysql"
  ],
  "author": {
    "name": "Camilo Andres Agudelo",
    "email": "andres18160@gmail.com"
  },
  "homepage": "https://github.com/caagudelo/mcp-db-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caagudelo/mcp-db-connect.git"
  },
  "bugs": {
    "url": "https://github.com/caagudelo/mcp-db-connect/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "minimist": "^1.2.8",
    "mssql": "^12.2.0",
    "mysql2": "^3.14.1",
    "pg": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/minimist": "^1.2.5",
    "@types/mssql": "^9.1.4",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.0",
    "rimraf": "^5.0.5",
    "shx": "^0.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "bin": {
    "mcp-db-connect": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
