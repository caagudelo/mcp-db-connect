{
  "name": "@cagudelo/mcp-db-connect",
  "version": "1.0.6",
  "description": "Servidor MCP para acceso a bases de datos",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "database",
    "sqlite",
    "sqlserver",
    "postgresql",
    "mysql"
  ],
  "author": "Camilo Andres Agudelo <andres18160@gmail.com> <www.cagudelo.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "minimist": "^1.2.8",
    "mssql": "^10.0.4",
    "mysql2": "^3.14.1",
    "pg": "^8.16.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/mssql": "^9.1.4",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.0",
    "rimraf": "^5.0.5",
    "shx": "^0.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "bin": {
    "mcp-db-connect": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 